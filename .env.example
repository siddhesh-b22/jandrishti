# ====================================================================
# JanDrishti — Environment Variables Specification
# ====================================================================

# Environment Mode: 'development' | 'staging' | 'production'
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=info

# Database Storage Configuration
DATABASE_PATH=database/mplads.db
AUDIT_DATABASE_PATH=database/audit_cases.db

# Cross-Origin Resource Sharing (CORS)
# In production, set to specific origins: e.g. "https://jandrishti.gov.in,https://jandrishti.nic.in"
# Set to "*" for open civic development
CORS_ORIGINS=*

# Rate Limiting Configuration (Sliding Window in memory)
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_MUTATIONS_PER_MINUTE=60

# Frontend API URL (Used during Vite build)
VITE_API_URL=http://localhost:8000
